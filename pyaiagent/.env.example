# Local synthetic demo. These public demo tokens are not production secrets.
ENVIRONMENT=local
MODEL_MODE=demo
AUTH_MODE=demo
DEMO_TOKEN=local-demo-client-token
STATUS_TOKEN=local-demo-status-token
RUNBOOK_TOKEN=local-demo-runbook-token
AGENT_URL=http://127.0.0.1:8000/
STATUS_URL=http://127.0.0.1:8001
RUNBOOK_URL=http://127.0.0.1:8002

# To use a real LLM, change MODEL_MODE to openai and supply a key.
LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=

# JWT mode verifies RS256 tokens against an operator-provided public key.
# AUTH_MODE=jwt
# JWT_PUBLIC_KEY_FILE=/run/secrets/issuer-public.pem
# JWT_ISSUER=https://identity.example.com/
# JWT_AUDIENCE=jagent
# Client only: A2A_TOKEN=<token acquired from your identity provider>
